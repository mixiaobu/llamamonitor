hrow ApiError(url, { status: res.status, message: "HTTP " + res.status, body: { raw: text } });\n        }\n        thr
ow ApiError(url, { status: res.status, parse: true, message: "invalid JSON" });\n      }\n      if (!res.ok) {\n       
 throw ApiError(url, { status: res.status, message: "HTTP " + res.status, body: data });\n      }\n      return data;\n
